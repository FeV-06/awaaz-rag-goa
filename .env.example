# ── Awaaz configuration ──────────────────────────────────────────────

# Sarvam AI API key — REQUIRED for voice input (Saaras v3 STT) and TTS (Bulbul v2)
SARVAM_API_KEY=

# Optional local LLM synthesis (privacy-first). Default OFF: the pipeline uses the
# deterministic extractive fast-path, which holds the <200ms latency budget.
AWAZ_ENABLE_LLM=false

# Local Ollama endpoint (OpenAI-compatible) — swap for any provider
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b
LLM_API_KEY=local-ollama

# Alternatively: Groq / Cerebras as external providers (only with AWAZ_ENABLE_LLM=true)
# GROQ_API_KEY=
# CEREBRAS_API_KEY=

# Embedding model (must support multilingual e5 style 'query:'/'passage:' prefixes)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Storage & index paths
DATA_DIR=./data
INDEX_DIR=./data/indexes
PROCESSED_DIR=./data/processed

# Server
HOST=0.0.0.0
PORT=7860
